{
  "permissions": {
    "deny": ["Read(**/.env)", "Edit(**/.env)", "Read(**/.dev.vars)", "Edit(**/.dev.vars)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisar-codigo.py\""
          }
        ]
      }
    ]
  }
}
