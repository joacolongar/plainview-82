# Número de WhatsApp de la marca, formato internacional sin + ni espacios (ej. 5493511234567)
VITE_WHATSAPP_NUMBER=549XXXXXXXXXX

# Clave pública (site key) del widget de Turnstile. La secreta (TURNSTILE_SECRET_KEY) va solo en Cloudflare y en
# web/.dev.vars, nunca acá. Para probar en local: 1x00000000000000000000AA (siempre pasa) o
# 2x00000000000000000000AB (siempre bloquea), con la secreta de prueba 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000
